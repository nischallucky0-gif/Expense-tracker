# ===================================================================
# Expense Tracker - Environment Configuration Example
# Copy this file to .env or export these environment variables before running
# ===================================================================

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/expense_tracker_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Server Port (Default is 8080)
PORT=8080

# Seed Sample Data (true to populate realistic data on initial startup)
SEED_SAMPLE_DATA=true

# Active Spring Profile (default uses MySQL; set to 'dev' to use in-memory H2 without MySQL)
SPRING_PROFILES_ACTIVE=
